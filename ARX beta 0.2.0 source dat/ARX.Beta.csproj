<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ARX.Beta</AssemblyName>
    <Version>0.2.2-beta</Version>
    <Product>ARX · Aion 2 Companion</Product>
    <ApplicationIcon>Assets/ARX.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/AionMeter.Core/AionMeter.Core.csproj" />
    <Resource Include="Assets/Atreia.jpg" />
    <None Update="Data/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../data/**/*"
             Link="GameData/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
