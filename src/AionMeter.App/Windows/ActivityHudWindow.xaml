<Window x:Class="AionMeter.App.Windows.ActivityHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATX · Activity" Width="290" Height="106" Left="80" Top="70"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False">
    <Border Background="#EC111726" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12"
            Padding="14,10" MouseLeftButtonDown="MoveHud">
        <DockPanel>
            <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Content="×" Click="CloseHud" />
            <StackPanel>
                <TextBlock x:Name="Kicker" Foreground="{StaticResource GoldBright}" FontSize="10" FontWeight="SemiBold" />
                <TextBlock x:Name="CountdownText" Foreground="{StaticResource Text}" FontFamily="{StaticResource NumberFont}" FontSize="28" />
                <TextBlock x:Name="ActivityName" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
