<Window x:Class="AionMeter.App.Windows.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATX · Aion 2" Width="1120" Height="730" MinWidth="900" MinHeight="640"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverFill}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#20253B" />
                                <Setter Property="Foreground" Value="{StaticResource GoldBright}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{StaticResource Bg1}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="Metric" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="192" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border Background="#0E1421" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="18,25,18,20">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,29">
                    <Border Width="42" Height="42" Background="#2B2530" CornerRadius="10" Margin="0,0,11,0">
                        <Path Data="M 0,20 L 11,0 L 22,20 L 16,20 L 11,10 L 6,20 Z M 8,22 L 11,16 L 14,22 Z"
                              Fill="{StaticResource GoldBright}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ATX" FontSize="23" FontWeight="Bold" LineHeight="25" />
                        <TextBlock Text="AION 2  /  GLOBAL" FontSize="9" Foreground="{StaticResource TextDim}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="CombatNav" GroupName="Section" Style="{StaticResource Nav}" Click="ShowCombat" />
                    <RadioButton x:Name="MapNav" GroupName="Section" Style="{StaticResource Nav}" Click="ShowMap" />
                    <RadioButton x:Name="TimersNav" GroupName="Section" Style="{StaticResource Nav}" Click="ShowTimers" />
                    <Border Height="1" Background="{StaticResource Line}" Margin="4,10,4,13" />
                    <Button x:Name="HistoryButton" Style="{StaticResource GhostButton}" Margin="0,0,0,6" Click="ShowHistory" />
                    <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" Click="ShowSettings" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="LanguageButton" Style="{StaticResource GhostButton}" Click="ToggleLanguage" Margin="0,0,0,12" />
                    <TextBlock x:Name="VersionLabel" Style="{StaticResource Caption}" Margin="5,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26,22,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,17">
                <Button x:Name="HudButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Click="ToggleHud" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <Grid x:Name="CombatPage" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border CornerRadius="13" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="22,17">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                            <GradientStop Color="#151C2F" />
                            <GradientStop Color="#25203A" Offset="0.65" />
                            <GradientStop Color="#3A2C3F" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock x:Name="Eyebrow" Foreground="{StaticResource GoldBright}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock x:Name="FightTitle" FontSize="33" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,4" />
                        <TextBlock x:Name="FightSubtitle" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,13,0,13">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="DamageLabel" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="DamageValue" Style="{StaticResource Metric}" Foreground="{StaticResource GoldBright}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="4,0">
                        <StackPanel>
                            <TextBlock x:Name="HealingLabel" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="HealingValue" Style="{StaticResource Metric}" Foreground="{StaticResource Green}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SelfLabel" Style="{StaticResource Caption}" />
                            <TextBlock x:Name="SelfValue" Style="{StaticResource Metric}" FontSize="25" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock x:Name="PartyTitle" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="PartyHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <DataGrid x:Name="PartyGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{StaticResource Line}" Background="{StaticResource Bg1}"
                                  RowBackground="{StaticResource Bg1}" AlternatingRowBackground="#161D2D"
                                  Foreground="{StaticResource Text}" BorderThickness="0" RowHeight="32"
                                  CanUserResizeColumns="False" SizeChanged="ResizePartyColumns"
                                  MouseDoubleClick="OpenPlayer" KeyDown="PartyKeyDown">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource Bg2}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
                                    <Setter Property="Padding" Value="8,8" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="DPS" Binding="{Binding Dps}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn x:Name="DamageColumn" Binding="{Binding Damage}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="HPS" Binding="{Binding Hps}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn x:Name="HealingColumn" Binding="{Binding Healing}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn x:Name="CritColumn" Binding="{Binding Crit}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn x:Name="BurstColumn" Binding="{Binding Burst}" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <DockPanel x:Name="MapPage" Grid.Row="1" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock x:Name="MapTitle" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock x:Name="MapHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,10" />
                    <Button x:Name="BrowserButton" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OpenMapBrowser" />
                </StackPanel>
                <Grid x:Name="MapHost">
                    <TextBlock x:Name="MapStatus" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </DockPanel>

            <DockPanel x:Name="TimersPage" Grid.Row="1" Visibility="Collapsed">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock x:Name="TimersTitle" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock x:Name="TimersHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <WrapPanel>
                        <Button x:Name="TimerHudButton" Style="{StaticResource GhostButton}" Margin="0,0,7,0" Click="ToggleTimerHud" />
                        <Button x:Name="BossButton" Style="{StaticResource GhostButton}" Margin="0,0,7,0" Click="ShowBosses" />
                        <Button x:Name="ScheduleButton" Style="{StaticResource GhostButton}" Click="OpenSchedule" />
                    </WrapPanel>
                </StackPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="AddTimerLabel" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,11" />
                        <WrapPanel>
                            <TextBox x:Name="TimerName" Width="210" MaxLength="48" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                            <TextBox x:Name="TimerMinutes" Width="62" MaxLength="5" Margin="0,0,8,0" VerticalContentAlignment="Center" Text="30" />
                            <Button x:Name="AddTimerButton" Style="{StaticResource PrimaryButton}" Click="AddTimer" />
                        </WrapPanel>
                        <TextBlock x:Name="TimerError" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <DockPanel>
                    <Button x:Name="RemoveTimerButton" DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                            Margin="0,9,0,0" Click="RemoveTimer" />
                    <ListBox x:Name="TimerList" Background="{StaticResource Bg1}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"
                             DisplayMemberPath="Display" />
                </DockPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
